// src/components/AnimatedSquares.js
import React, { useState, useRef } from 'react';
import { motion, useMotionValue, useAnimationFrame } from 'framer-motion';
import { useNavigate } from 'react-router-dom';

const FloatingSquare = ({
	topPct,
	leftPct,
	size,
	driftX,
	driftY,
	delay,
	duration,
	zIndex,
	imageUrl,
	item
}) => {
	const navigate = useNavigate();
	const x = useMotionValue(0);
	const y = useMotionValue(0);
	const [isPaused, setIsPaused] = useState(false);
	const [isSelected, setIsSelected] = useState(false);

	// Track timing to freeze phase while paused
	const lastTimeRef = useRef(0);
	const pausedAtRef = useRef(null);
	const totalPausedRef = useRef(0);

	// Angular velocity (radians/ms) for smooth oscillation
	const omega = (2 * Math.PI) / (duration * 1000);
	const startOffsetMs = delay * 1000;

	useAnimationFrame((t) => {
		lastTimeRef.current = t;
		if (isPaused || isSelected) return;

		// Subtract total paused duration so phase does not advance while paused
		const effectiveT = Math.max(0, t - startOffsetMs - totalPausedRef.current);
		const sx = Math.sin(effectiveT * omega) * driftX;
		const sy = Math.cos(effectiveT * omega) * driftY;
		x.set(sx);
		y.set(sy);
	});

	// Elevate hovered/paused/selected square above all others
	const effectiveZ = (isPaused || isSelected) ? 100 : zIndex;

	return (
		<motion.div
			className="absolute bg-black/40 dark:bg-white/40 backdrop-blur-md overflow-hidden group"
			style={{
				zIndex: effectiveZ,
				width: `${size}px`,
				height: `${size}px`,
				top: `${topPct}%`,
				left: `${leftPct}%`,
				x,
				y,
				opacity: (isPaused || isSelected) ? 1 : 0.7
			}}
			onMouseEnter={() => {
				if (!isPaused && !isSelected) {
					setIsPaused(true);
					pausedAtRef.current = lastTimeRef.current;
				}
			}}
			onMouseLeave={() => {
				if (isSelected) return; // keep paused/elevated when selected
				if (pausedAtRef.current != null) {
					totalPausedRef.current += (lastTimeRef.current - pausedAtRef.current);
					pausedAtRef.current = null;
				}
				setIsPaused(false);
			}}
			onClick={(e) => {
				e.stopPropagation();
				// If an item with a targetUrl is provided, navigate to it
				if (item && item.targetUrl) {
					navigate(item.targetUrl);
					return;
				}
				// Fallback to select/deselect behavior when no item is provided
				if (!isSelected) {
					setIsSelected(true);
					if (!isPaused) {
						setIsPaused(true);
						pausedAtRef.current = lastTimeRef.current;
					}
				} else {
					setIsSelected(false);
					if (pausedAtRef.current != null) {
						totalPausedRef.current += (lastTimeRef.current - pausedAtRef.current);
						pausedAtRef.current = null;
					}
					setIsPaused(false);
				}
			}}
		>
			<div
				className="absolute inset-0 bg-contain bg-center bg-no-repeat transition-opacity duration-200"
				style={{ backgroundImage: `url('${imageUrl}')`, opacity: (isSelected || isPaused) ? 1 : 0.1 }}
			/>
		</motion.div>
	);
};

const AnimatedSquares = ({
	count = 5,
	minSize = 60,
	maxSize = 120,
	drift = 30,        // default amplitude if per-axis not provided
	driftXAmplitude,   // optional override for X amplitude
	driftYAmplitude,   // optional override for Y amplitude
	spawnPaddingPct = 10, // keep spawn points away from edges (percentage of parent)
	minDuration = 1,   // seconds
	maxDuration = 3,   // seconds
	items = []         // Optional: array of { mediaSrc, targetUrl, title }
}) => {
	// Sanitize spawn padding (0..49)
	const pad = Math.max(0, Math.min(49, Number.isFinite(spawnPaddingPct) ? spawnPaddingPct : 0));
	const amplitudeX = (Number.isFinite(driftXAmplitude) ? driftXAmplitude : drift);
	const amplitudeY = (Number.isFinite(driftYAmplitude) ? driftYAmplitude : drift);

	// Generate square properties once and store them
	const [squares] = useState(() => 
		Array.from({ length: count }, (_, i) => {
			const topPct = pad + Math.random() * (100 - 2 * pad);
			const leftPct = pad + Math.random() * (100 - 2 * pad);
			const size = (Math.random() * (maxSize - minSize)) + minSize;
			const driftX = (Math.random() * 2 - 1) * amplitudeX;
			const driftY = (Math.random() * 2 - 1) * amplitudeY;
			const delay = Math.random() * maxDuration;
			const duration = Math.random() * (maxDuration - minDuration) + minDuration;
			const zIndex = Math.floor(Math.random() * 10) + 1;

			// Map items deterministically to avoid duplicates when possible
			let item = null;
			if (items && items.length > 0) {
				item = items[i % items.length];
			}

			return { topPct, leftPct, size, driftX, driftY, delay, duration, zIndex, item };
		})
	);

	return (
		<div className="absolute inset-0">
			{squares.map((square, i) => {
				if (!square.item || !square.item.mediaSrc || square.item.mediaSrc.trim() === "") {
					return null;
				}
				return (
					<FloatingSquare
						key={i}
						{...square}
						imageUrl={square.item.mediaSrc}
						item={square.item}
					/>
				);
			})}
		</div>
	);
};

export default AnimatedSquares;